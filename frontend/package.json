{
  "name": "langua-linker-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:beta": "vite build --mode beta --outDir dist-beta",
    "build:release": "vite build --mode release --outDir dist-release",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "lint:i18n": "node scripts/check-ui-strings.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:beta": "npm run build:beta && node scripts/verify-release-bundle.mjs dist-beta",
    "verify:release": "npm run build:release && node scripts/verify-release-bundle.mjs dist-release",
    "tauri": "cross-env TAURI_APP_PATH=../src-tauri tauri",
    "variant": "node scripts/tauri-variant.mjs",
    "app:dev": "node scripts/tauri-variant.mjs dev dev",
    "android:dev": "node scripts/tauri-variant.mjs dev android dev",
    "android:apk": "node scripts/tauri-variant.mjs dev android build --debug --apk",
    "ios:dev": "node scripts/tauri-variant.mjs dev ios dev"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/plugin-notification": "2.5.1",
    "i18next": "26.4.4",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "svelte-check": "4.1.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
