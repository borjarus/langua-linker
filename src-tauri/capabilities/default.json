{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: every AppApi command of contract v1 (crates/contracts/v1/catalogue.json; commands without a backend yet answer NOT_IMPLEMENTED) plus core event listen/unlisten. No fs/shell/http plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-get-app-info",
    "allow-get-attributions",
    "allow-get-about-info",
    "allow-get-diagnostics-report",
    "allow-get-dashboard",
    "allow-get-deck",
    "allow-create-deck",
    "allow-update-deck",
    "allow-delete-deck",
    "allow-list-presets",
    "allow-save-preset",
    "allow-start-study",
    "allow-resume-study",
    "allow-update-study-session",
    "allow-get-rating-preview",
    "allow-rate-card",
    "allow-undo-review",
    "allow-apply-card-action",
    "allow-get-session-summary",
    "allow-get-note-details",
    "allow-get-note-content",
    "allow-get-editor-data",
    "allow-check-duplicate",
    "allow-save-note",
    "allow-delete-note",
    "allow-update-note-content",
    "allow-set-favorite-association",
    "allow-resolve-word-link",
    "allow-search-words",
    "allow-generate-association",
    "allow-search-cards",
    "allow-preview-bulk-action",
    "allow-apply-bulk-action",
    "allow-get-stats",
    "allow-get-settings",
    "allow-update-settings",
    "allow-set-ai-api-key",
    "allow-request-notification-permission",
    "allow-get-onboarding-state",
    "allow-complete-onboarding",
    "allow-preview-reset",
    "allow-reset-collection",
    "allow-pick-file",
    "allow-preview-import",
    "allow-commit-deck-import",
    "allow-preview-deck-import",
    "allow-commit-import",
    "allow-export-deck",
    "allow-share-file",
    "allow-list-backups",
    "allow-create-backup",
    "allow-validate-restore",
    "allow-restore-backup",
    "allow-get-job-status",
    "allow-cancel-job"
  ]
}
