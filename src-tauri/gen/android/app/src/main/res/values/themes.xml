<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.langualinker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Edge-to-edge (targetSdk 36): the bars are transparent over the window background, which
             matches the app background (CSS color-bg token), with dark icons in the light theme. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
