{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanguaLinker",
  "version": "0.1.0",
  "identifier": "com.mila.langualinker",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend -- --mode release",
    "beforeBuildCommand": "npm run build:release --prefix ../frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist-release"
  },
  "app": {
    "windows": [
      {
        "title": "LanguaLinker",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}