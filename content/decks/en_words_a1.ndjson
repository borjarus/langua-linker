{"guid": "enw-eac9ed049034", "front": "this", "back": "to / ten", "tags": ["pronoun", "A1"], "associations": [{"guid": "enw-eac9ed049034-a1", "text": "Wskazujesz palcem rzecz tuż obok ciebie: this – ten, to tutaj.", "promptVersion": "association-candidates-v1", "model": "claude-opus-5-5"}]}
