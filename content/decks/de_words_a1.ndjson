{"guid": "dew-924f07f23863", "front": "viel", "back": "dużo", "tags": ["adverb", "A1"], "associations": [{"guid": "dew-924f07f23863-a1", "text": "viel brzmi jak „wiele” – i znaczy właśnie dużo.", "promptVersion": "association-candidates-v1", "model": "claude-opus-5-5"}]}
