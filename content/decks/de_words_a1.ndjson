{"guid": "dew-582b1ab084ee", "front": "Deutsch", "back": "niemiecki (język)", "tags": ["noun", "A1"], "associations": [{"guid": "dew-582b1ab084ee-a1", "text": "Deutsch – „dojcz”, jak w potocznym „Dojczland”. Sprechen Sie Deutsch? – Mówi pan po niemiecku?", "promptVersion": "association-candidates-v1", "model": "claude-opus-5-5"}]}
{"guid": "dew-ea6cd338bce8", "front": "heute", "back": "dzisiaj", "tags": ["adverb", "A1"], "associations": [{"guid": "dew-ea6cd338bce8-a1", "text": "„Hoj, ahoj! Dziś wypływamy!” – woła żeglarz. heute brzmi „hojte”: dzisiaj.", "promptVersion": "association-candidates-v1", "model": "claude-opus-5-5"}]}
