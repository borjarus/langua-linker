{"guid": "ens-e4e6c4cd8edb", "front": "I am going to the cinema tonight.", "back": "Idę dzisiaj wieczorem do kina.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-e4e6c4cd8edb-t1", "text": "Czas present continuous („am going”) wyraża tu plan na najbliższą przyszłość, a nie czynność trwającą w tej chwili"}], "wordLinks": [{"start": 0, "end": 1, "surfaceForm": "I", "lemma": "I", "wordGuid": "enw-de9a3323640a"}, {"start": 2, "end": 4, "surfaceForm": "am", "lemma": "to be", "wordGuid": "enw-34874860970f"}, {"start": 5, "end": 10, "surfaceForm": "going", "lemma": "to go", "wordGuid": "enw-81953ef2569f"}, {"start": 11, "end": 13, "surfaceForm": "to", "lemma": "to", "wordGuid": "enw-3d881b61b41d"}, {"start": 14, "end": 17, "surfaceForm": "the", "lemma": "the", "wordGuid": "enw-76d8c7be91fb"}, {"start": 18, "end": 24, "surfaceForm": "cinema", "lemma": "cinema", "wordGuid": "enw-c399bb881ed9"}, {"start": 25, "end": 32, "surfaceForm": "tonight", "lemma": "tonight", "wordGuid": "enw-5afa0a323513"}]}
{"guid": "ens-0dbbccb55344", "front": "What is your name?", "back": "Jak się nazywasz?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-0dbbccb55344-t1", "text": "Angielski pyta „co”, nie „jak” — dosłowne „How is your name?” jest błędem"}], "wordLinks": [{"start": 0, "end": 4, "surfaceForm": "What", "lemma": "what", "wordGuid": "enw-6ad7aa1dd67f"}, {"start": 5, "end": 7, "surfaceForm": "is", "lemma": "to be", "wordGuid": "enw-34874860970f"}, {"start": 8, "end": 12, "surfaceForm": "your", "lemma": "your", "wordGuid": "enw-84182d343252"}, {"start": 13, "end": 17, "surfaceForm": "name", "lemma": "name", "wordGuid": "enw-e843f536ed64"}]}
{"guid": "ens-328ec26d2386", "front": "I come from Poland.", "back": "Pochodzę z Polski.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-328ec26d2386-t1", "text": "Nazwy krajów w języku angielskim nie mają rodzajnika: „from Poland”, a nie „from the Poland”"}], "wordLinks": [{"start": 0, "end": 1, "surfaceForm": "I", "lemma": "I", "wordGuid": "enw-de9a3323640a"}, {"start": 2, "end": 6, "surfaceForm": "come", "lemma": "to come", "wordGuid": "enw-68621ce2bcc8"}, {"start": 7, "end": 11, "surfaceForm": "from", "lemma": "from", "wordGuid": "enw-0fe0c0469619"}, {"start": 12, "end": 18, "surfaceForm": "Poland", "lemma": "Poland", "wordGuid": "enw-155635f5496e"}]}
{"guid": "ens-42f4dfb8e678", "front": "This is my sister.", "back": "To jest moja siostra.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-42f4dfb8e678-t1", "text": "„my” nie odmienia się przez rodzaj ani liczbę — „my sister” i „my brothers”"}], "wordLinks": [{"start": 0, "end": 4, "surfaceForm": "This", "lemma": "this", "wordGuid": "enw-eac9ed049034"}, {"start": 5, "end": 7, "surfaceForm": "is", "lemma": "to be", "wordGuid": "enw-34874860970f"}, {"start": 8, "end": 10, "surfaceForm": "my", "lemma": "my", "wordGuid": "enw-d872d901f8df"}, {"start": 11, "end": 17, "surfaceForm": "sister", "lemma": "sister", "wordGuid": "enw-39d7c7a1ee24"}]}
{"guid": "ens-7941ec6222c7", "front": "Where is the station?", "back": "Gdzie jest dworzec?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-7941ec6222c7-t1", "text": "W pytaniu czasownik „is” stoi przed podmiotem — to inwersja"}], "wordLinks": [{"start": 0, "end": 5, "surfaceForm": "Where", "lemma": "where", "wordGuid": "enw-ccff9453ce8e"}, {"start": 6, "end": 8, "surfaceForm": "is", "lemma": "to be", "wordGuid": "enw-34874860970f"}, {"start": 9, "end": 12, "surfaceForm": "the", "lemma": "the", "wordGuid": "enw-76d8c7be91fb"}, {"start": 13, "end": 20, "surfaceForm": "station", "lemma": "station", "wordGuid": "enw-8bf2b6c3a4b0"}]}
{"guid": "ens-696655b1c5dd", "front": "I want a coffee, please.", "back": "Chciałbym kawę, proszę.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-696655b1c5dd-t1", "text": "„a coffee” z rodzajnikiem oznacza jedną porcję; samo „coffee” to kawa jako substancja"}], "wordLinks": [{"start": 0, "end": 1, "surfaceForm": "I", "lemma": "I", "wordGuid": "enw-de9a3323640a"}, {"start": 2, "end": 6, "surfaceForm": "want", "lemma": "to want", "wordGuid": "enw-4414f20ea2f8"}, {"start": 7, "end": 8, "surfaceForm": "a", "lemma": "a", "wordGuid": "enw-2e0c62e9c2c4"}, {"start": 9, "end": 15, "surfaceForm": "coffee", "lemma": "coffee", "wordGuid": "enw-14043cf8ef97"}, {"start": 17, "end": 23, "surfaceForm": "please", "lemma": "please", "wordGuid": "enw-b54457e9f8c7"}]}
{"guid": "ens-5b8883a5f550", "front": "How much does it cost?", "back": "Ile to kosztuje?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-5b8883a5f550-t1", "text": "Operator „does” tworzy pytanie, dlatego czasownik główny zostaje w bezokoliczniku: „cost”, nie „costs”"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "How", "lemma": "how", "wordGuid": "enw-082ae6e4c656"}, {"start": 4, "end": 8, "surfaceForm": "much", "lemma": "much", "wordGuid": "enw-c9a49b2a7fdb"}, {"start": 9, "end": 13, "surfaceForm": "does", "lemma": "to do", "wordGuid": "enw-8266345717e8"}, {"start": 14, "end": 16, "surfaceForm": "it", "lemma": "it", "wordGuid": "enw-5ff15dde8890"}, {"start": 17, "end": 21, "surfaceForm": "cost", "lemma": "to cost", "wordGuid": "enw-e2be621e5e89"}]}
{"guid": "ens-2d44850e1402", "front": "I do not understand this.", "back": "Nie rozumiem tego.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-2d44850e1402-t1", "text": "Przeczenie wymaga operatora „do not” (skrót „don't”); nie wystarczy dodać „not” do czasownika"}], "wordLinks": [{"start": 0, "end": 1, "surfaceForm": "I", "lemma": "I", "wordGuid": "enw-de9a3323640a"}, {"start": 2, "end": 8, "surfaceForm": "do not", "lemma": "do not", "wordGuid": "enw-44c5a29f4169"}, {"start": 9, "end": 19, "surfaceForm": "understand", "lemma": "to understand", "wordGuid": "enw-f60810548c79"}, {"start": 20, "end": 24, "surfaceForm": "this", "lemma": "this", "wordGuid": "enw-eac9ed049034"}]}
{"guid": "ens-65aa0232bff4", "front": "Can you help me?", "back": "Czy możesz mi pomóc?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-65aa0232bff4-t1", "text": "Po czasowniku modalnym „can” stoi bezokolicznik bez „to”: „can help”, nie „can to help”"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Can", "lemma": "can", "wordGuid": "enw-5cc35e203a86"}, {"start": 4, "end": 7, "surfaceForm": "you", "lemma": "you", "wordGuid": "enw-94c1dd9b6d6e"}, {"start": 8, "end": 12, "surfaceForm": "help", "lemma": "to help", "wordGuid": "enw-8df541b8c21d"}, {"start": 13, "end": 15, "surfaceForm": "me", "lemma": "me", "wordGuid": "enw-fe3e87befa79"}]}
{"guid": "ens-d1a58558a6fa", "front": "The weather is nice today.", "back": "Dzisiaj jest ładna pogoda.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-d1a58558a6fa-t1", "text": "„weather” jest niepoliczalne — nie ma formy „weathers” ani „a weather”"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "The", "lemma": "the", "wordGuid": "enw-76d8c7be91fb"}, {"start": 4, "end": 11, "surfaceForm": "weather", "lemma": "weather", "wordGuid": "enw-91c130d7043c"}, {"start": 12, "end": 14, "surfaceForm": "is", "lemma": "to be", "wordGuid": "enw-34874860970f"}, {"start": 15, "end": 19, "surfaceForm": "nice", "lemma": "nice", "wordGuid": "enw-898f563f1e62"}, {"start": 20, "end": 25, "surfaceForm": "today", "lemma": "today", "wordGuid": "enw-ddedd156ed1c"}]}
{"guid": "ens-efc2263e9342", "front": "I learn English every day.", "back": "Uczę się angielskiego codziennie.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-efc2263e9342-t1", "text": "„every day” pisze się rozdzielnie i znaczy „codziennie”; „everyday” razem to przymiotnik „powszedni”"}], "wordLinks": [{"start": 0, "end": 1, "surfaceForm": "I", "lemma": "I", "wordGuid": "enw-de9a3323640a"}, {"start": 2, "end": 7, "surfaceForm": "learn", "lemma": "to learn", "wordGuid": "enw-f7f18c4c0f69"}, {"start": 8, "end": 15, "surfaceForm": "English", "lemma": "English", "wordGuid": "enw-4111f372de0b"}, {"start": 16, "end": 21, "surfaceForm": "every", "lemma": "every", "wordGuid": "enw-2b5d0c6d6eea"}, {"start": 22, "end": 25, "surfaceForm": "day", "lemma": "day", "wordGuid": "enw-f11399f0851b"}]}
{"guid": "ens-83f09510013f", "front": "We meet on Monday.", "back": "Spotykamy się w poniedziałek.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "ens-83f09510013f-t1", "text": "Z dniami tygodnia używa się przyimka „on”: „on Monday”, nie „in Monday”"}], "wordLinks": [{"start": 0, "end": 2, "surfaceForm": "We", "lemma": "we", "wordGuid": "enw-45b1efaa4947"}, {"start": 3, "end": 7, "surfaceForm": "meet", "lemma": "to meet", "wordGuid": "enw-beef05fdb10f"}, {"start": 8, "end": 10, "surfaceForm": "on", "lemma": "on", "wordGuid": "enw-088423d6d585"}, {"start": 11, "end": 17, "surfaceForm": "Monday", "lemma": "Monday", "wordGuid": "enw-078cd96b3d93"}]}
