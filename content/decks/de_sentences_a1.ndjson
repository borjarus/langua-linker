{"guid": "des-6016fc91ae7a", "front": "Ich gehe heute Abend ins Kino.", "back": "Idę dzisiaj wieczorem do kina.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-6016fc91ae7a-t1", "text": "„ins” = „in das” (skrócenie przedimka w bierniku po przyimku „in”)"}, {"guid": "des-6016fc91ae7a-t2", "text": "„heute Abend” oznacza „dzisiaj wieczorem”, a nie dosłowne tłumaczenie słowo w słowo"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Ich", "lemma": "ich", "wordGuid": "dew-4999ee134d5c"}, {"start": 4, "end": 8, "surfaceForm": "gehe", "lemma": "gehen", "wordGuid": "dew-935d6e4936a7"}, {"start": 9, "end": 14, "surfaceForm": "heute", "lemma": "heute", "wordGuid": "dew-ea6cd338bce8"}, {"start": 15, "end": 20, "surfaceForm": "Abend", "lemma": "der Abend", "wordGuid": "dew-d88b6ff3d5d6"}, {"start": 21, "end": 24, "surfaceForm": "ins", "lemma": "in das", "wordGuid": "dew-0f2ae9914304"}, {"start": 25, "end": 29, "surfaceForm": "Kino", "lemma": "das Kino", "wordGuid": "dew-a2e50cfaa221"}]}
{"guid": "des-c464ec5d1587", "front": "Wie heißt du?", "back": "Jak się nazywasz?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-c464ec5d1587-t1", "text": "Pytania bez słowa pytającego na końcu mają czasownik na drugiej pozycji — tutaj „heißt” stoi po „Wie”"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Wie", "lemma": "wie", "wordGuid": "dew-6facbaad5d60"}, {"start": 4, "end": 9, "surfaceForm": "heißt", "lemma": "heißen", "wordGuid": "dew-7f78b6f5d8f7"}, {"start": 10, "end": 12, "surfaceForm": "du", "lemma": "du", "wordGuid": "dew-a28fc1fd6069"}]}
{"guid": "des-b5ce41ee19c6", "front": "Ich komme aus Polen.", "back": "Pochodzę z Polski.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-b5ce41ee19c6-t1", "text": "„aus” + nazwa kraju wyraża pochodzenie i wymaga celownika"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Ich", "lemma": "ich", "wordGuid": "dew-4999ee134d5c"}, {"start": 4, "end": 9, "surfaceForm": "komme", "lemma": "kommen", "wordGuid": "dew-1c6d20c63b95"}, {"start": 10, "end": 13, "surfaceForm": "aus", "lemma": "aus", "wordGuid": "dew-819721064b68"}, {"start": 14, "end": 19, "surfaceForm": "Polen", "lemma": "Polen", "wordGuid": "dew-4f690d59933f"}]}
{"guid": "des-37bf50caba8a", "front": "Das ist meine Schwester.", "back": "To jest moja siostra.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-37bf50caba8a-t1", "text": "„mein” odmienia się przez rodzaj: „meine Schwester” (rodzaj żeński), ale „mein Bruder” (rodzaj męski)"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Das", "lemma": "das", "wordGuid": "dew-0cc91a6a83a7"}, {"start": 4, "end": 7, "surfaceForm": "ist", "lemma": "sein", "wordGuid": "dew-50604bf1656d"}, {"start": 8, "end": 13, "surfaceForm": "meine", "lemma": "mein", "wordGuid": "dew-244c1faa6e46"}, {"start": 14, "end": 23, "surfaceForm": "Schwester", "lemma": "die Schwester", "wordGuid": "dew-c7504d4ead9b"}]}
{"guid": "des-1b0df90ff05e", "front": "Wo ist der Bahnhof?", "back": "Gdzie jest dworzec?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-1b0df90ff05e-t1", "text": "Po słowie pytającym „Wo” czasownik stoi od razu na drugiej pozycji"}], "wordLinks": [{"start": 0, "end": 2, "surfaceForm": "Wo", "lemma": "wo", "wordGuid": "dew-84de67440eda"}, {"start": 3, "end": 6, "surfaceForm": "ist", "lemma": "sein", "wordGuid": "dew-50604bf1656d"}, {"start": 7, "end": 10, "surfaceForm": "der", "lemma": "der", "wordGuid": "dew-4597d35dd68b"}, {"start": 11, "end": 18, "surfaceForm": "Bahnhof", "lemma": "der Bahnhof", "wordGuid": "dew-b51ed86953c7"}]}
{"guid": "des-d42f815c42cb", "front": "Ich möchte einen Kaffee, bitte.", "back": "Chciałbym kawę, proszę.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-d42f815c42cb-t1", "text": "„einen” to biernik rodzaju męskiego od „ein” — „der Kaffee” staje się „einen Kaffee”"}, {"guid": "des-d42f815c42cb-t2", "text": "„möchte” jest formą uprzejmą; „ich will” brzmi w niemieckim znacznie bardziej stanowczo"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Ich", "lemma": "ich", "wordGuid": "dew-4999ee134d5c"}, {"start": 4, "end": 10, "surfaceForm": "möchte", "lemma": "möchten", "wordGuid": "dew-60228c407194"}, {"start": 11, "end": 16, "surfaceForm": "einen", "lemma": "ein", "wordGuid": "dew-93c2f90abe4f"}, {"start": 17, "end": 23, "surfaceForm": "Kaffee", "lemma": "der Kaffee", "wordGuid": "dew-b005d64c16db"}, {"start": 25, "end": 30, "surfaceForm": "bitte", "lemma": "bitte", "wordGuid": "dew-700c87ac402b"}]}
{"guid": "des-7389a4d3a8aa", "front": "Wie viel kostet das?", "back": "Ile to kosztuje?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-7389a4d3a8aa-t1", "text": "„Wie viel” pisze się rozdzielnie, gdy pytamy o cenę lub ilość niepoliczalną"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Wie", "lemma": "wie", "wordGuid": "dew-6facbaad5d60"}, {"start": 4, "end": 8, "surfaceForm": "viel", "lemma": "viel", "wordGuid": "dew-924f07f23863"}, {"start": 9, "end": 15, "surfaceForm": "kostet", "lemma": "kosten", "wordGuid": "dew-777ce22f1d55"}, {"start": 16, "end": 19, "surfaceForm": "das", "lemma": "das", "wordGuid": "dew-0cc91a6a83a7"}]}
{"guid": "des-3262151a2302", "front": "Ich verstehe das nicht.", "back": "Nie rozumiem tego.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-3262151a2302-t1", "text": "„nicht” stoi na końcu zdania, a nie przed czasownikiem jak polskie „nie”"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Ich", "lemma": "ich", "wordGuid": "dew-4999ee134d5c"}, {"start": 4, "end": 12, "surfaceForm": "verstehe", "lemma": "verstehen", "wordGuid": "dew-3ed4a532d707"}, {"start": 13, "end": 16, "surfaceForm": "das", "lemma": "das", "wordGuid": "dew-0cc91a6a83a7"}, {"start": 17, "end": 22, "surfaceForm": "nicht", "lemma": "nicht", "wordGuid": "dew-d94098dccd54"}]}
{"guid": "des-c020d05a038c", "front": "Können Sie mir helfen?", "back": "Czy może mi pan pomóc?", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-c020d05a038c-t1", "text": "W pytaniach bez słowa pytającego czasownik wychodzi na pierwszą pozycję"}, {"guid": "des-c020d05a038c-t2", "text": "„helfen” wymaga celownika, dlatego „mir”, a nie „mich”"}], "wordLinks": [{"start": 0, "end": 6, "surfaceForm": "Können", "lemma": "können", "wordGuid": "dew-0102a02c2e48"}, {"start": 7, "end": 10, "surfaceForm": "Sie", "lemma": "Sie", "wordGuid": "dew-4c85f3dc7361"}, {"start": 11, "end": 14, "surfaceForm": "mir", "lemma": "mir", "wordGuid": "dew-acbb8c31fcea"}, {"start": 15, "end": 21, "surfaceForm": "helfen", "lemma": "helfen", "wordGuid": "dew-4ab07bf7ff58"}]}
{"guid": "des-995f12556a02", "front": "Heute ist das Wetter schön.", "back": "Dzisiaj jest ładna pogoda.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-995f12556a02-t1", "text": "Gdy zdanie zaczyna się okolicznikiem czasu („Heute”), czasownik nadal stoi na drugiej pozycji, a podmiot przechodzi za niego"}], "wordLinks": [{"start": 0, "end": 5, "surfaceForm": "Heute", "lemma": "heute", "wordGuid": "dew-ea6cd338bce8"}, {"start": 6, "end": 9, "surfaceForm": "ist", "lemma": "sein", "wordGuid": "dew-50604bf1656d"}, {"start": 10, "end": 13, "surfaceForm": "das", "lemma": "das", "wordGuid": "dew-0cc91a6a83a7"}, {"start": 14, "end": 20, "surfaceForm": "Wetter", "lemma": "das Wetter", "wordGuid": "dew-d41103f96766"}, {"start": 21, "end": 26, "surfaceForm": "schön", "lemma": "schön", "wordGuid": "dew-4e2ddca57416"}]}
{"guid": "des-f9ba4de52193", "front": "Ich lerne seit zwei Jahren Deutsch.", "back": "Uczę się niemieckiego od dwóch lat.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-f9ba4de52193-t1", "text": "„seit” + celownik oznacza czynność trwającą do teraz — po polsku użylibyśmy czasu przeszłego, w niemieckim jest teraźniejszy"}, {"guid": "des-f9ba4de52193-t2", "text": "„Jahren” to celownik liczby mnogiej od „das Jahr”"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Ich", "lemma": "ich", "wordGuid": "dew-4999ee134d5c"}, {"start": 4, "end": 9, "surfaceForm": "lerne", "lemma": "lernen", "wordGuid": "dew-f7305a6e7b69"}, {"start": 10, "end": 14, "surfaceForm": "seit", "lemma": "seit", "wordGuid": "dew-395550040e55"}, {"start": 15, "end": 19, "surfaceForm": "zwei", "lemma": "zwei", "wordGuid": "dew-ed65df035740"}, {"start": 20, "end": 26, "surfaceForm": "Jahren", "lemma": "das Jahr", "wordGuid": "dew-7039d8ed409e"}, {"start": 27, "end": 34, "surfaceForm": "Deutsch", "lemma": "Deutsch", "wordGuid": "dew-582b1ab084ee"}]}
{"guid": "des-77d9ac613d42", "front": "Wir treffen uns am Montag.", "back": "Spotykamy się w poniedziałek.", "tags": ["phrase", "A1"], "grammarTips": [{"guid": "des-77d9ac613d42-t1", "text": "„am” = „an dem” (skrócenie w celowniku) i używa się go z dniami tygodnia"}, {"guid": "des-77d9ac613d42-t2", "text": "„sich treffen” jest zwrotne, dlatego pojawia się „uns”"}], "wordLinks": [{"start": 0, "end": 3, "surfaceForm": "Wir", "lemma": "wir", "wordGuid": "dew-78ef182c607a"}, {"start": 4, "end": 11, "surfaceForm": "treffen", "lemma": "treffen", "wordGuid": "dew-a1c9132351ed"}, {"start": 12, "end": 15, "surfaceForm": "uns", "lemma": "uns", "wordGuid": "dew-a239dc0bb41e"}, {"start": 16, "end": 18, "surfaceForm": "am", "lemma": "an dem", "wordGuid": "dew-0e8b841814fc"}, {"start": 19, "end": 25, "surfaceForm": "Montag", "lemma": "der Montag", "wordGuid": "dew-f611785246fa"}]}
