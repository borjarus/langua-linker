    "invariants": [
      "reps = 1 after the first review with any rating",
      "nextReviewDate = reviewDate + scheduledDays",
      "Easy path stability > Good path stability after two reviews",
      "desiredRetention 0.99 gives scheduledDays ≤ desiredRetention 0.70 after New→Good→Good"
    ]
  }
